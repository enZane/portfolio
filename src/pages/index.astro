---
import { getCollection } from "astro:content";
import { Font, Image } from "astro:assets";
import portrait from "../assets/sql-px-portrait.png";
import projectsFile from "../data/projects.json";
import "../styles/global.css";

// First slide of each deck, keyed by talk id (screenshots live in src/assets/talks).
const covers = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/talks/*.png",
	{ eager: true },
);
const coverFor = (id: string) => covers[`../assets/talks/${id}.png`]?.default;

// Authored order — projects.json is the running order. The file loader hands
// entries back sorted by id, so the authored sequence has to be restored.
const projectOrder = projectsFile.map((project) => project.id);
const projects = (await getCollection("projects")).sort(
	(a, b) => projectOrder.indexOf(a.id) - projectOrder.indexOf(b.id),
);

// The eyebrow tells you where the link actually goes.
const domainOf = (url: string) =>
	new URL(url).hostname.replace(/^www\./, "");

// Strictly newest first — the year markers in the gutter depend on it.
const talks = (await getCollection("talks")).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Consecutive talks from the same year share one marker. Within a year the
// featured talk leads, because it takes the full-width row.
const byYear = talks
	.reduce<{ year: number; talks: typeof talks }[]>((groups, talk) => {
		const year = talk.data.date.getUTCFullYear();
		const current = groups.at(-1);
		if (current?.year === year) current.talks.push(talk);
		else groups.push({ year, talks: [talk] });
		return groups;
	}, [])
	.map((group) => ({
		...group,
		talks: group.talks.sort(
			(a, b) => Number(b.data.featured) - Number(a.data.featured),
		),
	}));

const talkDate = new Intl.DateTimeFormat("en-US", {
	month: "long",
	year: "numeric",
	timeZone: "UTC",
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Almendra Olivas is a full-stack engineer, co-founder of Coyomi Labs, and speaker building platforms and interfaces that are fast, accessible, and gentle to use."
		/>
		<title>Almendra Olivas — Full-stack engineer, founder &amp; speaker</title>
		<Font cssVariable="--astro-font-display" preload />
		<Font cssVariable="--astro-font-body" preload />
		<Font cssVariable="--astro-font-bitmap" />
	</head>
	<body>
		<a href="#main" class="skip-link label">Skip to content</a>

		<!-- Masthead and hero share the field colour so they read as one block. -->
		<header class="bg-field">
			<div
				class="mx-auto flex max-w-6xl flex-wrap items-baseline justify-between gap-x-6 gap-y-2 px-6 py-6"
			>
				<p class="label font-bold">Almendra Olivas</p>
				<a href="#contact" class="label masthead-link">Say hello</a>
			</div>
		</header>

		<main id="main">
			<section class="bg-field" aria-labelledby="name">
				<div
					class="mx-auto grid max-w-6xl items-end gap-x-12 px-6 md:grid-cols-[1fr_auto]"
				>
					<div class="max-w-2xl pt-10 pb-16 md:pt-20 md:pb-32">
						<h1
							id="name"
							class="text-[clamp(3.25rem,11vw,7rem)] leading-[0.84] tracking-[-0.045em]"
						>
							Almendra<br />Olivas
						</h1>
						<hr class="mt-10 w-24 border-0 border-t-4 border-ink" />
						<p
							class="mt-8 max-w-[38ch] text-lg leading-[1.6] text-ink/80 sm:text-xl"
						>
							I build platforms and interfaces that are fast,
							accessible, and gentle to use — from the database
							to the last pixel — and I speak about the craft
							behind them.
						</p>
						<div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
							<a href="#projects" class="button">See the work</a>
							<a href="#talks" class="quiet-link">Talks I've given</a>
						</div>
					</div>

					<!--
						The portrait's own background is exactly --field, so it has no
						visible edge here: only the figure shows, rising out of the
						dithered boundary below.
					-->
					<div class="justify-self-center md:justify-self-end">
						<img
							src={portrait.src}
							width={portrait.width}
							height={portrait.height}
							alt="Pixel-art portrait of Almendra: long dark hair, glasses, a black hoodie, and a small smile."
							decoding="async"
							fetchpriority="high"
							class="pixelated block w-56 sm:w-72 lg:w-[26rem]"
						/>
					</div>
				</div>
			</section>

			<div class="dither" aria-hidden="true">
				<span class="dither-dense"></span><span class="dither-sparse"></span>
			</div>

			<section
				id="about"
				class="mx-auto max-w-6xl px-6 py-24 md:py-32"
				aria-labelledby="about-heading"
			>
				<div class="grid gap-y-8 md:grid-cols-[9rem_1fr] md:gap-x-12">
					<h2 id="about-heading" class="label pt-3 text-muted">About</h2>
					<div class="max-w-[58ch]">
						<p class="text-2xl leading-[1.4] font-medium tracking-[-0.015em]">
							I think the web should be soft, welcoming, and built
							for everyone.
						</p>
						<div class="mt-8 space-y-6 text-[1.0625rem] leading-[1.7] text-muted">
							<p>
								My work sits where performant code meets humane
								design. I care about the details that make an
								interface feel effortless — especially for the
								people who usually get designed around instead
								of designed for.
							</p>
							<p>
								Eight-plus years of that, mostly on platforms and
								products: at Octahedroid I worked on Composabase,
								on Pantheon's open-source decoupled-kit-js SDKs,
								and with enterprise teams at Okta, Auth0, and
								Databricks — and now I'm co-founder of Coyomi
								Labs.
							</p>
							<p>
								These days I build component systems, shape
								accessible experiences, and speak about the
								things that matter to me: inclusive design,
								queer and trans visibility in tech, and writing
								code that lasts.
							</p>
							<p>
								Being a trans woman is part of who I am, and it
								shapes how I show up as an engineer and as a
								community member. I want the spaces I help build
								— online and off — to be places where people can
								be fully themselves.
							</p>
						</div>
					</div>
				</div>
			</section>

			<section
				id="projects"
				class="border-t-2 border-rule"
				aria-labelledby="projects-heading"
			>
				<div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
					<div class="grid gap-y-8 md:grid-cols-[9rem_1fr] md:gap-x-12">
						<h2 id="projects-heading" class="label pt-3 text-muted">
							Projects
						</h2>
						<p
							class="max-w-[46ch] text-2xl leading-[1.4] font-medium tracking-[-0.015em]"
						>
							What I'm building — platforms, products, and the
							tools around them. Where there's a link, it goes
							straight to the live thing.
						</p>
					</div>

					<ul class="mt-16 border-t-2 border-ink">
						{
							projects.map((project) => {
								// Same body either way; only the row wrapper and the
								// gutter change when there is nothing to link to yet.
								const body = (
									<div>
										<h3 class="project-name text-[1.75rem] leading-[1.1] sm:text-[2rem]">
											{project.data.name}
										</h3>
										<p class="mt-3 max-w-[54ch] leading-[1.65] text-muted">
											{project.data.description}
										</p>
										{project.data.tags.length > 0 && (
											<ul class="mt-5 flex flex-wrap gap-2">
												{project.data.tags.map((tag) => (
													<li class="tag label">{tag}</li>
												))}
											</ul>
										)}
									</div>
								);
								const row =
									"-mx-4 grid gap-x-12 gap-y-4 px-4 py-9 md:grid-cols-[9rem_1fr_2rem] md:items-baseline";

								return (
									<li class="border-b-2 border-rule">
										{project.data.url ? (
											<a
												href={project.data.url}
												target="_blank"
												rel="noopener noreferrer"
												class={`project ${row}`}
											>
												<p class="label text-muted">
													{domainOf(project.data.url)}
												</p>
												{body}
												<span
													class="project-arrow hidden text-2xl md:block"
													aria-hidden="true"
												>
													↗
												</span>
											</a>
										) : (
											<div class={row}>
												<p class="label">
													<span class="badge inline-block">
														Coming soon
													</span>
												</p>
												{body}
											</div>
										)}
									</li>
								);
							})
						}
					</ul>
				</div>
			</section>

			<section
				id="community"
				class="border-t-2 border-rule"
				aria-labelledby="community-heading"
			>
				<div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
					<div class="grid gap-y-8 md:grid-cols-[9rem_1fr] md:gap-x-12">
						<h2 id="community-heading" class="label pt-3 text-muted">
							Community
						</h2>
						<div class="max-w-[58ch]">
							<p class="text-2xl leading-[1.4] font-medium tracking-[-0.015em]">
								I run <a
									href="https://dgotechcrafters.org/"
									target="_blank"
									rel="noopener noreferrer"
									class="masthead-link">Tech Crafters</a
								>, a developer community in Durango.
							</p>
							<div class="mt-8 space-y-6 text-[1.0625rem] leading-[1.7] text-muted">
								<p>
									We meet to learn together — workshops on AI
									tooling, modern web development, and the craft
									of building things well. Most of the talks below
									happened there. I want Durango to be a place
									where you don't have to leave to grow.
								</p>
							</div>
						</div>
					</div>
				</div>
			</section>

			<section
				id="talks"
				class="border-t-2 border-rule"
				aria-labelledby="talks-heading"
			>
				<div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
					<div class="grid gap-y-8 md:grid-cols-[9rem_1fr] md:gap-x-12">
						<h2 id="talks-heading" class="label pt-3 text-muted">
							Talks
						</h2>
						<p
							class="max-w-[46ch] text-2xl leading-[1.4] font-medium tracking-[-0.015em]"
						>
							Every deck is still live. Open one and read it at
							your own pace.
						</p>
					</div>

					{
						byYear.map((group) => (
							<div class="mt-16">
								<div class="flex items-baseline gap-4 border-t-4 border-ink pt-3">
									<p class="label font-bold">{group.year}</p>
									<p class="label text-muted">
										{group.talks.length}{" "}
										{group.talks.length === 1 ? "talk" : "talks"}
									</p>
								</div>
								<ul class="mt-6 grid gap-x-3 gap-y-6 sm:grid-cols-2">
									{group.talks.map((talk) => {
										const cover = coverFor(talk.id);
										const meta = (
											<p class="label flex flex-wrap items-center gap-x-3 gap-y-2 text-muted">
												<time
													datetime={talk.data.date
														.toISOString()
														.slice(0, 10)}
												>
													{talkDate.format(talk.data.date)}
												</time>
												{talk.data.badge && (
													<span class="badge">{talk.data.badge}</span>
												)}
											</p>
										);
										const title = (
											<a
												href={talk.data.url}
												target="_blank"
												rel="noopener noreferrer"
											>
												{talk.data.title}
												<span class="sr-only">
													— open the slides in a new tab
												</span>
											</a>
										);

										// The featured talk takes the whole row and reads
										// left to right; the rest stay compact.
										return talk.data.featured ? (
											<li class="talk featured col-span-full border-2 border-void p-4 shadow-hard sm:p-6">
												<article class="grid gap-6 sm:grid-cols-[minmax(0,24rem)_1fr] sm:items-center sm:gap-10">
													{cover && (
														<div class="talk-thumb border-2 border-void bg-card">
															<Image
																src={cover}
																alt=""
																widths={[420, 840]}
																sizes="(min-width: 640px) 384px, 84vw"
																loading="lazy"
																class="aspect-video w-full object-cover"
															/>
														</div>
													)}
													<div>
														{meta}
														<h3 class="talk-title mt-4 text-[1.75rem] leading-[1.15] sm:text-[2.25rem]">
															{title}
														</h3>
														<p class="mt-4 max-w-[52ch] leading-[1.65] text-muted">
															{talk.data.description}
														</p>
														<p class="talk-cue label mt-6 inline-flex items-center gap-2">
															Open slides
															<span aria-hidden="true">↗</span>
														</p>
													</div>
												</article>
											</li>
										) : (
											<li class="talk p-4">
												{cover && (
													<div class="talk-thumb border-2 border-ink bg-card">
														<Image
															src={cover}
															alt=""
															widths={[520, 1040]}
															sizes="(min-width: 1152px) 514px, (min-width: 640px) 45vw, 84vw"
															loading="lazy"
															class="aspect-video w-full object-cover"
														/>
													</div>
												)}
												<div class="mt-5">{meta}</div>
												<h3 class="talk-title mt-3 text-xl leading-[1.2]">
													{title}
												</h3>
												<p class="mt-2 line-clamp-3 text-[0.9375rem] leading-[1.6] text-muted">
													{talk.data.description}
												</p>
											</li>
										);
									})}
								</ul>
							</div>
						))
					}
				</div>
			</section>
			<div class="dither" aria-hidden="true">
				<span class="dither-sparse"></span><span class="dither-dense"></span>
			</div>

			<section
				id="contact"
				class="bg-field"
				aria-labelledby="contact-heading"
			>
				<div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
					<div class="grid gap-y-8 md:grid-cols-[9rem_1fr] md:gap-x-12">
						<h2 id="contact-heading" class="label pt-3 text-ink/65">
							Contact
						</h2>
						<div>
							<p
								class="max-w-[24ch] font-display text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.02] font-extrabold tracking-[-0.04em]"
							>
								Say hello.
							</p>
							<p class="mt-6 max-w-[40ch] text-lg leading-[1.6] text-ink/80">
								Email is the surest way to reach me. I read
								everything that lands there.
							</p>

							<ul class="mt-12 border-t-2 border-ink/25">
								<li class="border-b-2 border-ink/25">
									<a
										class="contact-row"
										href="mailto:almendra.zn.olivas@gmail.com"
									>
										<span class="label text-ink/65">Email</span>
										<span class="contact-value"
											>almendra.zn.olivas@gmail.com</span
										>
										<span class="contact-arrow" aria-hidden="true">→</span>
									</a>
								</li>
								<li class="border-b-2 border-ink/25">
									<a
										class="contact-row"
										href="https://github.com/enZane"
										target="_blank"
										rel="noopener noreferrer"
									>
										<span class="label text-ink/65">GitHub</span>
										<span class="contact-value">
											github.com/enZane
											<span class="sr-only">— opens in a new tab</span>
										</span>
										<span class="contact-arrow" aria-hidden="true">↗</span>
									</a>
								</li>
								{/*
									TODO: LinkedIn. No profile URL exists anywhere in
									this repo yet — drop in a copy of the GitHub row
									above with href="https://www.linkedin.com/in/…",
									label "LinkedIn", and the profile path as the value.
								*/}
							</ul>
						</div>
					</div>
				</div>
			</section>
		</main>

		<footer class="bg-field border-t-2 border-ink/25">
			<div
				class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-10"
			>
				<p class="label text-ink/65">
					© {new Date().getFullYear()} Almendra Olivas
				</p>
				<span class="pixel-run" aria-hidden="true"></span>
			</div>
		</footer>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		z-index: 10;
		background-color: var(--ink);
		color: var(--paper);
		padding: 0.75rem 1rem;
	}

	.skip-link:focus {
		left: 0;
	}

	.masthead-link {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		text-decoration-color: color-mix(in oklab, var(--ink) 40%, transparent);
		transition: text-decoration-color 120ms ease-out;
	}

	.masthead-link:hover {
		text-decoration-color: var(--ink);
	}

	/* Hard-edged, pressable. The whole system uses this one gesture. */
	.button {
		display: inline-block;
		font-family: var(--font-body);
		font-size: 0.9375rem;
		font-weight: 600;
		background-color: var(--ink);
		color: var(--paper);
		border: 2px solid var(--ink);
		padding: 0.75rem 1.5rem;
		box-shadow: var(--shadow-hard-sm);
		transition:
			transform 120ms ease-out,
			box-shadow 120ms ease-out;
	}

	.button:hover {
		transform: translate(4px, 4px);
		box-shadow: 0 0 0 var(--void);
	}

	.quiet-link {
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
		text-decoration-color: var(--ink);
		transition: text-decoration-color 120ms ease-out;
	}

	.quiet-link:hover {
		text-decoration-color: var(--rust);
	}

	/*
	 * Two-row dither: the boundary between the field and the paper, drawn the
	 * way a 1-bit display would fake a gradient. Order the rows dense-to-sparse
	 * to fade out of the field, sparse-to-dense to fade into it.
	 */
	.dither span {
		display: block;
		height: 14px;
	}

	.dither-dense {
		background: repeating-linear-gradient(
			90deg,
			var(--field) 0 14px,
			transparent 14px 28px
		);
	}

	.dither-sparse {
		background: repeating-linear-gradient(
			90deg,
			var(--field) 0 14px,
			transparent 14px 56px
		);
		background-position: 14px 0;
	}

	/*
	 * Project rows fill with the field colour instead of pressing in — a list
	 * reads better as a sweep than as a stack of buttons.
	 */
	.project {
		transition: background-color 140ms ease-out;
	}

	.project:hover,
	.project:focus-visible {
		background-color: var(--field);
	}

	.project:hover .text-muted,
	.project:focus-visible .text-muted {
		color: color-mix(in oklab, var(--ink) 78%, transparent);
	}

	.project-name {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
		text-decoration-color: transparent;
		transition: text-decoration-color 140ms ease-out;
	}

	.project:hover .project-name,
	.project:focus-visible .project-name {
		text-decoration-color: var(--ink);
	}

	.project-arrow {
		justify-self: end;
		transition: transform 140ms ease-out;
	}

	.project:hover .project-arrow,
	.project:focus-visible .project-arrow {
		transform: translate(4px, -4px);
	}

	.tag {
		border: 2px solid var(--rule);
		padding: 0.35rem 0.5rem 0.25rem;
		color: var(--muted);
	}

	.project:hover .tag,
	.project:focus-visible .tag {
		border-color: color-mix(in oklab, var(--ink) 30%, transparent);
		color: color-mix(in oklab, var(--ink) 78%, transparent);
	}

	.badge {
		background-color: var(--ink);
		color: var(--paper);
		padding: 0.3rem 0.5rem 0.2rem;
	}

	/* One link per talk, stretched across the whole row. */
	.talk {
		position: relative;
	}

	.talk-title a {
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 6px;
		text-decoration-color: transparent;
		transition: text-decoration-color 140ms ease-out;
	}

	.talk-title a::after {
		content: "";
		position: absolute;
		inset: 0;
	}

	.talk-thumb {
		box-shadow: var(--shadow-hard-sm);
		transition:
			transform 140ms ease-out,
			box-shadow 140ms ease-out;
	}

	.talk:hover .talk-thumb,
	.talk:focus-within .talk-thumb {
		transform: translate(4px, 4px);
		box-shadow: 0 0 0 var(--void);
	}

	.talk:hover .talk-title a,
	.talk:focus-within .talk-title a {
		text-decoration-color: var(--rust);
	}

	/*
	 * The featured talk gets the field colour and the full row. It is one
	 * block, so the block moves on hover instead of the thumbnail inside it.
	 */
	.featured {
		background-color: var(--field);
		transition:
			transform 140ms ease-out,
			box-shadow 140ms ease-out;
	}

	.featured .text-muted,
	.featured .talk-cue {
		color: color-mix(in oklab, var(--ink) 78%, transparent);
	}

	.featured .talk-thumb,
